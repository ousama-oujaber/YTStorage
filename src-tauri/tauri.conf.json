{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTDisk",
  "version": "1.0.0",
  "identifier": "com.ytdisk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YTDisk Desktop — 4K Optical Video Storage",
        "width": 1120,
        "height": 780,
        "minWidth": 850,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Store and recover files inside 4K YouTube videos with Reed-Solomon error correction",
    "longDescription": "YTDisk Desktop transforms arbitrary files into high-density 4K videos using Reed-Solomon error correction and AES-256-GCM encryption, with integrated YouTube and Google Drive downloading.",
    "copyright": "Copyright © 2026 Ousama Oujaber",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
